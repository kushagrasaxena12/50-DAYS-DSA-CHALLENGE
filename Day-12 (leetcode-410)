class Solution {
    public int splitArray(int[] nums, int k) {
        int start = 0;
        int end = 0;

        for (int num : nums) {
            start = Math.max(start, num);
            end += num;
        }
        while (start < end) {
            int mid = start + (end - start) / 2;
            int sum = 0;
            int parts = 1;

            for (int num : nums) {
                if (sum + num > mid) {
                    parts++;
                    sum = num;
                } else {
                    sum += num;
                }
            }
            if (parts <= k) {
                end = mid;
            } else {
                start = mid + 1;
            }
        }
        return start;
    }
}

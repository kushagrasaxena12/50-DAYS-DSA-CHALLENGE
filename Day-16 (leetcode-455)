import java.util.Arrays;
class Solution {
    public int findContentChildren(int[] g, int[] s) {
        int content=0;
        Arrays.sort(s);
        Arrays.sort(g);
        for(int i =0; i < g.length ; i++){
            for (int j = 0; j <  s.length ; j++){
                if(s[j] >= g[i]){
                    s[j]=0;
                    content++;
                    break;
                }                
            }
        }        
        return content;        
    }
}

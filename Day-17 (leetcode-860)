class Solution {
    public boolean lemonadeChange(int[] bills) {
        for(int i = 0; i < bills.length; i++){
            if(bills[i] == 5){
                continue;
            }
            if(bills[i] == 10){
                boolean found = false;

                for(int j = 0; j < i; j++){
                    if(bills[j] == 5){
                        bills[j] = 0;
                        found = true;
                        break;
                    }
                }
                if(!found){
                    return false;
                }
            }
            if(bills[i] == 20){
                boolean found10 = false;
                boolean found5 = false;

                for(int j = 0; j < i; j++){
                    if(bills[j] == 10){
                        bills[j] = 0;
                        found10 = true;
                        break;
                    }
                }
                if(found10){
                    for(int j = 0; j < i; j++){
                        if(bills[j] == 5){
                            bills[j] = 0;
                            found5 = true;
                            break;
                        }
                    }
                    if(!found5){
                        return false;
                    }
                } else {
                    int count = 0;
                    for(int j = 0; j < i; j++){
                        if(bills[j] == 5){
                            bills[j] = 0;
                            count++;

                            if(count == 3){
                                break;
                            }
                        }
                    }
                    if(count < 3){
                        return false;
                    }
                }
            }
        }
        return true;
    }
}
